<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MPAndroidChart</RootNamespace>
    <AssemblyName>MPAndroidChart</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Additions/Util/EntryXComparator.cs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- MPChartLib is built with minSdkVersion 14; 21 is the lowest .NET 10 for Android supports -->
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <!-- replaces the old [assembly: LinkerSafe] -->
    <IsTrimmable>true</IsTrimmable>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <!-- everything the binding consumes is listed explicitly below; the default globs would also try to
         bind Jars/MPChartLib-sources.jar -->
    <EnableDefaultAndroidItems>false</EnableDefaultAndroidItems>
    <!-- Javadoc comments come from the sources jar (JavaSourceJar) instead of the old JavaDocs/ HTML folder -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1572: javadoc @param tags on Java setters that the generator turned into C# properties.
         CS0108/CS0114: protected fields/methods a Java subclass re-declares; same names, harmless. -->
    <NoWarn>$(NoWarn);CS1591;CS1572;CS0108;CS0114</NoWarn>

    <PackageId>MPAndroidChart</PackageId>
    <Title>MPAndroidChart</Title>
    <Description>A .NET for Android binding by Lucas Teixeira for MPAndroidChart by Philipp Jahoda.</Description>
    <PackageReleaseNotes>MPAndroidChart master @ 9c7275a0 (2025-06-05), the 63 commits after v3.1.0 (Fill/gradients, IValueFormatter restored, bug fixes). .NET 10 / net10.0-android. Changes: https://github.com/PhilJay/MPAndroidChart/compare/v3.1.0...9c7275a0</PackageReleaseNotes>
    <Version>3.1.0.1</Version>
    <Authors>Flash3001</Authors>
    <Company></Company>
    <Copyright>Copyright 2016-2026 Lucas Teixeira</Copyright>
    <PackageProjectUrl>https://github.com/Flash3001/MPAndroidChart.Xamarin</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageTags>Xamarin;Android;dotnet-android;Chart;MPAndroidChart;LineChart;Combined-Chart;BarChart;Horizontal-BarChart;PieChart;ScatterChart;CandleStickChart;BubbleChart;RadarChart</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/SmokeTest is its own app project -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <AndroidLibrary Include="Jars\MPChartLib-release.aar" />
    <JavaSourceJar Include="Jars\MPChartLib-sources.jar" />
    <TransformFile Include="Transforms\Metadata.xml" />
    <TransformFile Include="Transforms\EnumFields.xml" />
    <TransformFile Include="Transforms\EnumMethods.xml" />
    <!-- NUGET.md is the consumer-facing readme shown on nuget.org; README.md is for this repo -->
    <None Include="NUGET.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
